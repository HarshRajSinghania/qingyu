# Qingyu Memory Gateway configuration
# Copy this file to .env and fill in the required values.
# Never commit a real .env file.

# Application identity
APP_NAME=Qingyu Memory Gateway
# Environment: development, test, production, etc. Non-test environments enforce secret strength.
APP_ENV=development

# HTTP server bind address and port
HOST=127.0.0.1
PORT=8000

# Required secrets (must be unique, non-empty, non-example values outside test env).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
EVIDENCE_READ_API_TOKEN=
EVIDENCE_CURSOR_SIGNING_KEY=

# PostgreSQL
# POSTGRES_PASSWORD is used by docker-compose. DATABASE_URL must contain the same password
# (percent-encode special characters in the URL).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://qingyu:<POSTGRES_PASSWORD>@127.0.0.1:5432/qingyu

# Filesystem path for the content-addressed raw archive (must be writable)
ARCHIVE_ROOT=<repo>/data

# Maximum size of an uploaded ChatGPT export zip (bytes)
IMPORT_UPLOAD_MAX_BYTES=536870912

# Staging cleanup worker
STAGING_FAILED_RETENTION_DAYS=7
STAGING_CLEANUP_INTERVAL_SECONDS=300
STAGING_CLEANUP_MAX_CANDIDATES=100

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
